    // captcha: el botón nunca se queda en «Enviando...» para siempre.
    function tokenCaptcha() {
        if (!captchaV3) {
            return Promise.resolve('');
        }

        return cargarApiCaptcha().then(function () {
            return new Promise(function (resolver) {
                var resuelto = false;

                function terminar(token) {
                    if (resuelto) {
                        return;
                    }

                    resuelto = true;
                    resolver(token || '');
