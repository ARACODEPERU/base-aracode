tus-pending-bg: #FEF3C7;\n    --table-status-pending-text: #92400E;\n    --table-status-failed-bg: #FEE2E2;\n    --table-status-failed-text: #991B1B;\n\n    /* Dark mode */\n    --table-dark-header-bg: #1F2937;\n    --table-dark-header-text: #9CA3AF;\n    --table-dark-row-bg: #111827;\n    --table-dark-row-hover: #1F2937;\n    --table-dark-border: #374151;\n    --table-dark-text-primary: #F9FAFB;\n    --table-dark-text-secondary: #9CA3AF;\n}\n\n/* ============================================\n   ESTILOS BASE PARA TABLAS\n   ============================================ */\n\n/* Contenedor de tabla con scroll horizontal */\n.table-responsive {\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n    padding: 0px;\n}\n\n/* Estilos base para todas las tablas */\ntable {\n    width: 100%;\n    border-collapse: collapse !important;\n    background-color: var(--table-row-bg);\n}\n\n/* Headers y Footers */\ntable thead tr,\ntable tfoot tr {\n    background-color: var(--table-header-bg) !important;\n    border-bottom: 0;\n}\n\ntable thead tr th,\ntable tfoot tr th {\n    padding: 12px 16px;\n    text-align: left;\n    font-weight: 600;\n    color: var(--table-header-text) !important;\n    background-color: var(--table-header-bg) !important;\n    border-bottom: 2px solid var(--table-header-border);\n    text-transform: uppercase;\n    font-size: 0.75rem;\n    letter-spacing: 0.05em;\n}\n\n/* Datatable - estilos específicos para el componente Vue */\n.datatable .bh-table-responsive table thead tr th {\n    background-color: var(--table-header-bg) !important;\n    color: var(--table-header-text) !important;\n    font-weight: 600;\n    text-transform: uppercase;\n    font-size: 0.75rem;\n    letter-spacing: 0.05em;\n}\n\n/* Celdas del cuerpo */\ntable tbody tr td {\n    padding: 12px 16px;\n    color: var(--table-text-primary);\n    border-bottom: 1px solid var(--table-border);\n    background-color: var(--table-row-bg);\n}\n\n/* Filas del cuerpo */\ntable tbody tr {\n    border-bottom: 1px solid var(--table-border);\n    background-color: var(--table-row-bg);\n    transition: background-color 0.2s ease;\n}\n\ntable tbody tr:hover {\n    background-color: var(--table-row-hover);\n}\n\n/* ============================================\n   TABLAS CON BORDER-RADIUS\n   ============================================ */\n\n/* Habilitar border-collapse: separate para permitir border-radius */\ntable.rounded-none {\n    border-collapse: separate;\n    border-spacing: 0;\n    border-radius: 0;\n    overflow: hidden;\n}\n\ntable.rounded,\ntable.rounded-sm,\ntable.rounded-md,\ntable.rounded-lg,\ntable.rounded-xl,\ntable.rounded-2xl,\ntable.rounded-3xl,\ntable.rounded-full {\n    border-collapse: separate;\n    border-spacing: 0;\n    overflow: hidden;\n}\n\ntable.rounded { border-radius: 0.25rem; }\ntable.rounded-sm { border-radius: 0.125rem; }\ntable.rounded-md { border-radius: 0.375rem; }\ntable.rounded-lg { border-radius: 0.5rem; }\ntable.rounded-xl { border-radius: 0.75rem; }\ntable.rounded-2xl { border-radius: 1rem; }\ntable.rounded-3xl { border-radius: 1.5rem; }\ntable.rounded-full { border-radius: 9999px; }\n\n/* Esquinas superiores */\ntable.rounded-2xl thead tr:first-child th:first-child { border-top-left-radius: 1rem; }\ntable.rounded-2xl thead tr:first-child th:last-child { border-top-right-radius: 1rem; }\n\n/* Esquinas inferiores */\ntable.rounded-2xl tbody tr:last-child td:first-child { border-bottom-left-radius: 1rem; }\ntable.rounded-2xl tbody tr:last-child td:last-child { border-bottom-right-radius: 1rem; }\n\n/* rounded-xl */\ntable.rounded-xl thead tr:first-child th:first-child { border-top-left-radius: 0.75rem; }\ntable.rounded-xl thead tr:first-child th:last-child { border-top-right-radius: 0.75rem; }\ntable.rounded-xl tbody tr:last-child td:first-child { border-bottom-left-radius: 0.75rem; }\ntable.rounded-xl tbody tr:last-child td:last-child { border-bottom-right-radius: 0.75rem; }\n\n/* rounded-lg */\ntable.rounded-lg 