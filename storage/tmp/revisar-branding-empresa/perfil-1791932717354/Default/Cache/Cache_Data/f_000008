T (a-select)\n   ----------------------------------------------------------------------------\n   Causa raiz corregida: el texto se pegaba arriba porque se forzo `height` en\n   el selector (38px) sin ajustar el `line-height` interno (quedaba en 30px de\n   antd). En antd el centrado vertical del single se logra con line-height\n   = (alto - 2px de borde). Ahora line-height acompaña al alto, el input de\n   busqueda usa el mismo alto y el multiple conserva `height:auto` para poder\n   envolver sus tags.\n   ============================================================================ */\n\n/* ---------- 1.1 Superficie del selector (single y multiple) ---------- */\n.ant-select-single:not(.ant-select-customize-input) .ant-select-selector,\n.ant-select-multiple .ant-select-selector {\n    background-color: #ffffff !important;\n    border-color: #e0e6ed !important;\n    border-radius: 6px !important;\n    font-size: 14px !important;\n}\n\n/* ---------- 1.2 Single ---------- */\n.ant-select-single:not(.ant-select-customize-input) .ant-select-selector {\n    height: 38px !important;\n    padding: 0 16px !important;\n    align-items: center;\n}\n\n.ant-select-single:not(.ant-select-customize-input) .ant-select-selection-item,\n.ant-select-single:not(.ant-select-customize-input) .ant-select-selection-placeholder {\n    line-height: 36px !important; /* 38px - 2px de borde: centrado perfecto */\n    font-weight: 600 !important;\n    color: #0e1726 !important;\n}\n\n.ant-select-single:not(.ant-select-customize-input) .ant-select-selection-placeholder {\n    color: #6b7280 !important;\n}\n\n/* Linea base interna que antd usa para alinear el texto (debe seguir al alto) */\n.ant-select-single:not(.ant-select-customize-input) .ant-select-selector:after {\n    line-height: 36px !important;\n}\n\n/* Input de busqueda del single (show-search): mismo alto para quedar centrado */\n.ant-select-single:not(.ant-select-customize-input) .ant-select-selection-search {\n    inset-inline-start: 16px;\n    inset-inline-end: 16px;\n    display: flex;\n    align-items: center;\n}\n\n.ant-select-single:not(.ant-select-customize-input) .ant-select-selection-search-input {\n    height: 36px !important;\n    line-height: 36px !important;\n}\n\n/* Con flecha: dejar espacio a la derecha para el icono */\n.ant-select-single:not(.ant-select-customize-input).ant-select-show-arrow .ant-select-selection-item,\n.ant-select-single:not(.ant-select-customize-input).ant-select-show-arrow .ant-select-selection-placeholder,\n.ant-select-single:not(.ant-select-customize-input).ant-select-allow-clear .ant-select-selection-item,\n.ant-select-single:not(.ant-select-customize-input).ant-select-allow-clear .ant-select-selection-placeholder {\n    padding-inline-end: 28px !important;\n}\n\n/* ---------- 1.3 Multiple ---------- */\n.ant-select-multiple .ant-select-selector {\n    min-height: 38px !important;\n    height: auto !important; /* los tags envuelven en varias filas */\n    padding: 4px 8px !important;\n}\n\n/* No permitir que la flecha / clear tapen el ultimo tag */\n.ant-select-multiple.ant-select-show-arrow .ant-select-selector,\n.ant-select-multiple.ant-select-allow-clear .ant-select-selector {\n    padding-inline-end: 28px !important;\n}\n\n.ant-select-multiple .ant-select-selection-item {\n    display: flex;\n    align-items: center;\n    background-color: #f4f6f8 !important;\n    border-color: #e0e6ed !important;\n    color: #0e1726 !important;\n    font-weight: 500 !important;\n}\n\n.ant-select-multiple .ant-select-selection-placeholder {\n    inset-inline-start: 8px !important;\n    color: #6b7280 !important;\n    font-weight: 600 !important;\n}\n\n.ant-select-multiple .ant-select-selection-item-remove {\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n}\n\n/* ---------- 1.4 Estados (hover / foco / disabled) ---------- */\n.ant-select:not(.ant-select-disabled):hover .ant-select-selector {\n    border-color: #4361ee !important;\n}\n\n.ant-select-focused .ant-select-selector {\n    border-color: #4361ee !important;\n    box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.12) !important;\n}\n\n.ant-select-disabled .ant-select-selector {\n    background-color: #f3f4f6 !important;\n}\n\n.ant-select-disabled .ant-select-selection-item,\n.ant-select-disabled .ant-select-selection-placeholder {\n    color: #6b7280 !important;\n}\n\n/* ---------- 1.5 Iconos (flecha / clear / remove) ---------- */\n.ant-select-arrow {\n    color: #888ea8 !important;\n    inset-inline-end: 16px !important;\n}\n\n/* `.ant-select-suffix` es la clase del icono (DownOutlined / SearchOutlined)\n   que vive dentro de `.ant-select-arrow`. */\n.ant-select-suffix {\n    color: #888ea8 !important;\n}\n\n.ant-select-clear {\n    inset-inline-end: 16px !important;\n    background-color: #ffffff !important;\n    color: #888ea8 !important;\n}\n\n.ant-select-clear:hover {\n    color: #4361ee !important;\n}\n\n/* ---------- 1.6 Dropdown / lista de opciones ---------- */\n.ant-select-dropdown {\n    background-color: #ffffff !important;\n    border: 1px solid #e0e6ed !important;\n    border-radius: 8px !important;\n    box-shadow: 0 6px 24px rgba(2, 6, 23, 0.08) !important;\n    padding: 4px !important;\n}\n\n.ant-select-item {\n    color: #0e1726 !important;\n    font-size: 14px !important;\n    font-weight: 500 !important;\n    border-radius: 6px !important;\n}\n\n.ant-select-item-option-active {\n    background-color: #eef2ff !important;\n}\n\n.ant-select-item-option-selected {\n    background-color: #eef2ff !important;\n    color: #4361ee !important;\n}\n\n.ant-select-item-option-selected .ant-select-item-option-state {\n    color: #4361ee !important;\n}\n\n.ant-select-item-empty {\n    color: #888ea8 !important;\n}\n\n/* ---------- 1.7 Select: tema oscuro ---------- */\n.dark .ant-select-single:not(.ant-select-customize-input) .ant-select-selector,\n.dark .ant-select-multiple .ant-select-selector {\n    background-color: #121e32 !important;\n    border-color: #17263c !important;\n}\n\n.dark .ant-select-single:not(.ant-select-customize-input) .ant-select-selection-item {\n    color: #888ea8 !important;\n}\n\n.dark .ant-select-single:not(.ant-select-customize-input) .ant-select-selection-placeholder {\n    color: #888ea8 !important;\n}\n\n.dark .ant-select-multiple .ant-select-selection-item {\n    background-color: #1b2e4b !important;\n    border-color: #253b5c !important;\n    color: #bfc5db !important;\n}\n\n.dark .ant-select-multiple .ant-select-selection-placeholder {\n    color: #888ea8 !important;\n}\n\n.dark .ant-select-arrow,\n.dark .ant-select-suffix {\n    color: #888ea8 !important;\n}\n\n.dark .ant-select-clear {\n    background-color: #121e32 !important;\n    color: #888ea8 !important;\n}\n\n.dark .ant-select-clear:hover {\n    color: #bfc5db !important;\n}\n\n.dark .ant-select-disabled .ant-select-selector {\n    background-color: #1b2e4b !important;\n}\n\n.dark .ant-select-disabled .ant-select-selection-item,\n.dark .ant-select-disabled .ant-select-selection-placeholder {\n    color: #9ca3af !important;\n}\n\n.dark .ant-select-dropdown {\n    background-color: #1b2e4b !important;\n    border-color: #253b5c !important;\n}\n\n.dark .ant-select-item {\n    color: #bfc5db !important;\n}\n\n.dark .ant-select-item-option-active {\n    background-color: #253d63 !important;\n    color: #bfc5db !important;\n}\n\n.dark .ant-select-item-option-selected {\n    background-color: #294064 !important;\n    color: #ffffff !important;\n}\n\n.dark .ant-select-item-option-selected .ant-select-item-option-state {\n    color: #ffffff !important;\n}\n\n.dark .ant-select-item-empty {\n    color: #888ea8 !important;\n}\n\n.dark .ant-select-selection-item-remove {\n    color: #dcdde6 !important;\n}\n\n.dark .anticon-close-circle {\n    background-color: transparent !important;\n    color: #888ea8 !important;\n}\n\n/* Compatibilidad con el componente legacy `.ara-ant-select` (tag mas alto) */\n.ara-ant-select .ant-select-selection-item {\n    height: 30px !important;\n    display: flex;\n    align-items: center;\n}\n\n/* ============================================================================\n   2) INPUT / TEXTAREA (a-input, a-textarea, Input.Search, Password)\n   ============================================================================ */\n.ant-input {\n    height: 38px !important;\n    padding: 0 16px !important;\n    background-color: #ffffff !important;\n    border-color: #e0e6ed !important;\n    border-radius: 6px !important;\n    color: #0e1726 !important;\n    font-size: 14px !important;\n    font-weight: 600 !important;\n    line-height: 36px !important;\n}\n\n.ant-input::-moz-placeholder {\n    color: #6b7280 !important;\n    opacity: 1 !important;\n}\n\n.ant-input::placeholder {\n    color: #6b7280 !important;\n    opacity: 1 !important;\n}\n\n.ant-input:hover {\n    border-color: #4361ee !important;\n}\n\n.ant-input:focus,\n.ant-input-focused {\n    border-color: #4361ee !important;\n    box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.12) !important;\n}\n\n.ant-input-disabled,\n.ant-input[disabled] {\n    background-color: #f3f4f6 !important;\n    color: #6b7280 !important;\n}\n\ntextarea.ant-input {\n    height: auto !important;\n    line-height: 1.5 !important;\n    padding: 8px 16px !important;\n}\n\n/* Wrapper con prefijo / sufijo (Input.Password, Input con icono) */\n.ant-input-affix-wrapper {\n    height: 38px !important;\n    padding: 0 16px !important;\n    background-color: #ffffff !important;\n    border-color: #e0e6ed !important;\n    border-radius: 6px !important;\n    line-height: 36px !important;\n}\n\n.ant-input-affix-wrapper:hover {\n    border-color: #4361ee !important;\n}\n\n.ant-input-affix-wrapper-focused,\n.ant-input-affix-wrapper:focus {\n    border-color: #4361ee !important;\n    box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.12) !important;\n}\n\n.ant-input-affix-wrapper .ant-input {\n    height: auto !important;\n    padding: 0 !important;\n    line-height: 36px !important;\n}\n\n/* Boton de Input.Search alineado al alto del input */\n.ant-input-search .ant-input-search-button {\n    height: 38px !important;\n    line-height: 38px;\n}\n\n/* ---------- Input / Textarea: tema oscuro ---------- */\n.dark .ant-input,\n.dark .ant-input-affix-wrapper {\n    background-color: #121e32 !important;\n    border-color: #17263c !important;\n    color: #888ea8 !important;\n}\n\n.dark .ant-input::-moz-placeholder {\n    color: #888ea8 !important;\n}\n\n.dark .ant-input::placeholder {\n    color: #888ea8 !important;\n}\n\n.dark .ant-input-disabled,\n.dark .ant-input[disabled] {\n    background-color: #1b2e4b !important;\n    color: #9ca3af !important;\n}\n\n/* ============================================================================\n   3) INPUT NUMBER (a-input-number)\n   ============================================================================ */\n.ant-input-number {\n    height: 38px !important;\n    background-color: #ffffff !important;\n    border-color: #e0e6ed !important;\n    border-radius: 6px !important;\n}\n\n.ant-input-number:hover {\n    border-color: #4361ee !important;\n}\n\n.ant-input-number-focused {\n    border-color: #4361ee !important;\n    box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.12) !important;\n}\n\n.ant-input-number-input {\n    height: 36px !important;\n    line-height: 36px !important;\n    padding: 0 16px !important;\n    color: #0e1726 !important;\n    font-size: 14px !important;\n    font-weight: 600 !important;\n}\n\n.ant-input-number-handler-wrap {\n    border-inline-start: 1px solid #e0e6ed !important;\n}\n\n/* ---------- InputNumber: tema oscuro ---------- */\n.dark .ant-input-number {\n    background-color: #121e32 !important;\n    border-color: #17263c !important;\n}\n\n.dark .ant-input-number-input {\n    background-color: transparent !important;\n    color: #888ea8 !important;\n}\n\n.dark .ant-input-number-handler-wrap {\n    border-inline-start-color: #17263c !important;\n}\n\n/* ============================================================================\n   4) DATE PICKER / RANGE PICKER / TIME PICKER (a-date-picker, etc.)\n   ============================================================================ */\n.ant-picker {\n    height: 38px !important;\n    padding: 0 16px !important;\n    background-color: #ffffff !important;\n    border-color: #e0e6ed !important;\n    border-radius: 6px !important;\n    color: #0e1726 !important;\n    font-size: 14px !important;\n}\n\n.ant-picker:hover {\n    border-color: #4361ee !important;\n}\n\n.ant-picker-focused,\n.ant-picker:focus {\n    border-color: #4361ee !important;\n    box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.12) !important;\n}\n\n.ant-picker-input > input {\n    height: 36px !important;\n    line-height: 36px !important;\n    color: #0e1726 !important;\n    font-size: 14px !important;\n    font-weight: 600 !important;\n}\n\n.ant-picker-input > input::-moz-placeholder {\n    color: #6b7280 !important;\n    opacity: 1 !important;\n}\n\n.ant-picker-input > input::placeholder {\n    color: #6b7280 !important;\n    opacity: 1 !important;\n}\n\n.ant-picker-suffix {\n    color: #888ea8 !important;\n}\n\n.ant-picker-clear {\n    background-color: #ffffff !important;\n    color: #888ea8 !important;\n}\n\n/* ---------- Panel del picker ---------- */\n.ant-picker-dropdown .ant-picker-panel-container {\n    background-color: #ffffff !important;\n    border: 1px solid #e0e6ed !important;\n    border-radius: 8px !important;\n    box-shadow: 0 6px 24px rgba(2, 6, 23, 0.08) !important;\n}\n\n.ant-picker-cell-in-view.ant-picker-cell-selected .ant-picker-cell-inner {\n    background-color: #4361ee !important;\n}\n\n.ant-picker-cell-in-view.ant-picker-cell-today .ant-picker-cell-inner::before {\n    border-color: #4361ee !important;\n}\n\n/* ---------- Picker: tema oscuro ---------- */\n.dark .ant-picker {\n    background-color: #121e32 !important;\n    border-color: #17263c !important;\n    color: #888ea8 !important;\n}\n\n.dark .ant-picker-input > input {\n    background-color: transparent !important;\n    color: #888ea8 !important;\n}\n\n.dark .ant-picker-input > input::-moz-placeholder {\n    color: #888ea8 !important;\n}\n\n.dark .ant-picker-input > input::placeholder {\n    color: #888ea8 !important;\n}\n\n.dark .ant-picker-suffix,\n.dark .ant-picker-clear {\n    color: #888ea8 !important;\n}\n\n.dark .ant-picker-clear {\n    background-color: #121e32 !important;\n}\n\n.dark .ant-picker-dropdown .ant-picker-panel-container {\n    background-color: #1b2e4b !important;\n    border-color: #253b5c !important;\n}\n\n.dark .ant-picker-header,\n.dark .ant-picker-content,\n.dark .ant-picker-footer {\n    background-color: transparent !important;\n}\n\n.dark .ant-picker-header-view button,\n.dark .ant-picker-content th,\n.dark .ant-picker-cell,\n.dark .ant-picker-cell-inner {\n    color: #bfc5db !important;\n}\n\n.dark .ant-picker-cell:hover .ant-picker-cell-inner {\n    background-color: #253d63 !important;\n}\n\n.dark .ant-picker-cell-in-view.ant-picker-cell-today .ant-picker-cell-inner::before {\n    border-color: #4361ee !important;\n}\n\n/* ============================================================================\n   5) AUTOCOMPLETE (a-auto-complete)\n   Usa la misma estructura del Select (`.ant-select` + `.ant-select-dropdown`),\n   por lo que hereda automaticamente las secciones 1.2, 1.4 y 1.6.\n   ============================================================================ */\n\n/* ============================================================================\n   6) TREESELECT (a-tree-select)\n   Comparte el dropdown del Select; solo se ajusta el arbol interno.\n   ============================================================================ */\n.ant-select-tree {\n    background-color: transparent !important;\n}\n\n.ant-select-tree .ant-select-tree-node-content-wrapper {\n    color: #0e1726 !important;\n    border-radius: 6px !important;\n}\n\n.ant-select-tree .ant-select-tree-node-content-wrapper:hover {\n    background-color: #eef2ff !important;\n}\n\n.ant-select-tree .ant-select-tree-node-selected {\n    background-color: #eef2ff !important;\n}\n\n/* ---------- TreeSelect: tema oscuro ---------- */\n.dark .ant-select-tree {\n    background-color: transparent !important;\n}\n\n.dark .ant-select-tree .ant-select-tree-node-content-wrapper {\n    color: #bfc5db !important;\n}\n\n.dark .ant-select-tree .ant-select-tree-node-content-wrapper:hover {\n    background-color: #253d63 !important;\n}\n\n.dark .ant-select-tree .ant-select-tree-node-selected {\n    background-color: #294064 !important;\n    color: #ffffff !important;\n}\n\n.dark .ant-select-tree-switcher-icon {\n    color: #888ea8 !important;\n}\n\n/* ============================================================================\n   7) CASCADER (a-cascader)\n   ============================================================================ */\n.ant-cascader-dropdown {\n    background-color: #ffffff !important;\n    border: 1px solid #e0e6ed !important;\n    border-radius: 8px !important;\n    box-shadow: 0 6px 24px rgba(2, 6, 23, 0.08) !important;\n}\n\n.ant-cascader-menu {\n    background-color: transparent !important;\n}\n\n.ant-cascader-menu-item {\n    color: #0e1726 !important;\n    font-weight: 500 !important;\n    border-radius: 6px !important;\n}\n\n.ant-cascader-menu-item:hover,\n.ant-cascader-menu-item-active {\n    background-color: #eef2ff !important;\n}\n\n.ant-cascader-menu-item-expand-icon,\n.ant-cascader-menu-item-loading-icon {\n    color: #888ea8 !important;\n}\n\n/* ---------- Cascader: tema oscuro ---------- */\n.dark .ant-cascader-dropdown {\n    background-color: #1b2e4b !important;\n    border-color: #253b5c !important;\n}\n\n.dark .ant-cascader-menu-item {\n    color: #bfc5db !important;\n}\n\n.dark .ant-cascader-menu-item:hover,\n.dark .ant-cascader-menu-item-active {\n    background-color: #253d63 !important;\n}\n\n/* ============================================================================\n   8) CHECKBOX (a-checkbox)\n   ============================================================================ */\n.ant-checkbox-wrapper:hover .ant-checkbox-inner,\n.ant-checkbox:hover .ant-checkbox-inner,\n.ant-checkbox-input:focus + .ant-checkbox-inner {\n    border-color: #4361ee !important;\n}\n\n.ant-checkbox-checked .ant-checkbox-inner,\n.ant-checkbox-indeterminate .ant-checkbox-inner {\n    background-color: #4361ee !important;\n    border-color: #4361ee !important;\n}\n\n.ant-checkbox-checked .ant-checkbox-inner::after {\n    border-color: #ffffff !important;\n}\n\n/* ============================================================================\n   9) RADIO (a-radio / a-radio-group)\n   ============================================================================ */\n.ant-radio:hover .ant-radio-inner,\n.ant-radio-wrapper:hover .ant-radio,\n.ant-radio-input:focus + .ant-radio-inner {\n    border-color: #4361ee !important;\n}\n\n.ant-radio-checked .ant-radio-inner {\n    border-color: #4361ee !important;\n}\n\n.ant-radio-checked .ant-radio-inner::after {\n    background-color: #4361ee !important;\n}\n\n/* ============================================================================\n   10) SWITCH (a-switch)\n   ============================================================================ */\n.ant-switch {\n    background-color: #888ea8 !important;\n}\n\n.ant-switch:hover:not(.ant-switch-disabled) {\n    background-color: #888ea8 !important;\n}\n\n.ant-switch-checked {\n    background-color: #4361ee !important;\n}\n\n.ant-switch-checked:hover:not(.ant-switch-disabled) {\n    background-color: #4361ee !important;\n}\n\n/* ============================================================================\n   11) BOTON (a-button)\n   Solo centrado vertical del contenido; colores por defecto de antd.\n   ============================================================================ */\n.ant-btn {\n    di