<!--
    Tema claro / oscuro.

    Se aplica aquí, antes de pintar nada: al recargar en oscuro no se ve el
    destello claro, y el interruptor y los controles del carrusel quedan
    ocultos hasta que haya JavaScript. Sin nada guardado la tienda arranca en
    claro aunque el sistema del visitante esté en oscuro.
-->
<script>
    (function () {
        var raiz = document.documentElement;

        raiz.classList.remove('no-js');
        raiz.classList.add('js');

        try {
            if (localStorage.getItem('nexora-market-tema') === 'oscuro') {
                raiz.setAttribute('data-tema', 'oscuro');
            }
        } catch (error) {
            /* Almacenamiento bloqueado (navegación privada): se queda en claro. */
        }
    })();
</script>

