    align-items: center;
    gap: .5rem;
    padding: .5rem .6rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, .045);
    border: 1px solid rgba(255, 255, 255, .07);
}

.ara-art__faq i {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, .45);
}

.ara-art__faq > span:nth-child(odd) i { width: 60%; }
.ara-art__faq > span:nth-child(even) i { width: 78%; }

.ara-art__faq b {
    margin-left: auto;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .6rem;
    font-weight: 700;
    line-height: 1;
    color: #07122C;
    background: rgba(94, 176, 255, .85);
}

.ara-art__faq > span:nth-child(2) b {
    color: #fff;
    background: #0188EE;
}

/* Precios: tres planes */
.ara-art__planes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .45rem;
    flex: 1;
}

.ara-art__planes > span {
    display: flex;
    flex-direction: column;
    gap: .34rem;
    padding: .55rem .5rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, .045);
    border: 1px solid rgba(255, 255, 255, .07);
}

.ara-art__planes .ara-art__plan--destacado {
    background: rgba(1, 136, 238, .14);
    border-color: rgba(94, 176, 255, .45);
}

.ara-art__planes em {
    display: block;
    width: 40%;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, .35);
}

.ara-art__planes b {
    display: block;
    width: 68%;
    height: .62rem;
    border-radius: 3px;
    margin: .1rem 0 .15rem;
    background: rgba(255, 255, 255, .82);
}

.ara-art__planes .ara-art__plan--destacado b { background: #6EE7A0; }

.ara-art__planes i {
    display: block;
    width: 88%;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, .2);
}

.ara-art__planes i:last-child { width: 55%; }

/* Legal: documento con sello */
.ara-art__doc {
    display: flex;
    flex-direction: column;
    gap: .45rem;
    flex: 1;
    padding: .7rem .8rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, .04);
    border: 1px solid rgba(255, 255, 255, .08);
}

.ara-art__doc i {
    display: block;
    width: 92%;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, .22);
}

.ara-art__doc .ara-art__doc-titulo {
    width: 46%;
    height: .5rem;
    border-radius: 3px;
    margin-bottom: .2rem;
    background: rgba(255, 255, 255, .8);
}

.ara-art__doc .ara-art__doc-corto { width: 42%; }

.ara-art__sello {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 50%;
    border: 2px dashed rgba(37, 211, 102, .5);
    background: rgba(37, 211, 102, .1);
}
