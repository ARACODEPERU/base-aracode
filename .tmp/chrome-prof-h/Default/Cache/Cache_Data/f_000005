}

.ara-art__cifras {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .5rem;
    margin-top: auto;
}

.ara-art__cifras b {
    display: flex;
    flex-direction: column;
    gap: .35rem;
    padding: .6rem .55rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, .045);
    border: 1px solid rgba(255, 255, 255, .07);
}

.ara-art__cifras i {
    display: block;
    width: 62%;
    height: .5rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, .82);
}

.ara-art__cifras em {
    display: block;
    width: 88%;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, .24);
}

/* Contacto: formulario y respuesta */
.ara-art__form {
    display: flex;
    flex-direction: column;
    gap: .4rem;
    flex: 1;
    padding-right: 42%;
}

.ara-art__form i {
    display: block;
    height: 1.1rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, .05);
    border: 1px solid rgba(255, 255, 255, .1);
}

.ara-art__form .ara-art__area {
    height: 2.6rem;
}

.ara-art__form b {
    display: block;
    width: 4.2rem;
    height: 1.1rem;
    border-radius: 9999px;
    margin-top: .1rem;
    background: linear-gradient(100deg, #0188EE, #0AA0FF);
}

.ara-art__burbuja {
    position: absolute;
    right: .9rem;
    bottom: .9rem;
    width: 40%;
    padding: .55rem .6rem;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: .28rem;
    background: rgba(37, 211, 102, .12);
    border: 1px solid rgba(37, 211, 102, .3);
}

.ara-art__burbuja i {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, .42);
}

.ara-art__burbuja i:last-child { width: 60%; }

/* Blog: tres artículos */
.ara-art__posts {
    display: flex;
    flex-direction: column;
    gap: .45rem;
    flex: 1;
}

.ara-art__post {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .45rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, .04);
    border: 1px solid rgba(255, 255, 255, .07);
}

.ara-art__thumb {
    flex: 0 0 auto;
    width: 2.2rem;
    height: 1.7rem;
    border-radius: 5px;
    background: linear-gradient(135deg, rgba(1, 136, 238, .6), rgba(37, 211, 102, .35));
}

.ara-art__post i:not(.ara-art__thumb) {
    display: block;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, .26);
}

.ara-art__post i:nth-child(2) {
    width: 62%;
    height: .45rem;
    background: rgba(255, 255, 255, .75);
}

.ara-art__post i:nth-child(3) { width: 40%; }

/* Casos: gráfico de resultados */
.ara-art__chart {
    display: flex;
    align-items: flex-end;
    gap: .45rem;
    flex: 1;
    padding: .3rem .1rem;
}

.ara-art__chart i {
    flex: 1;
    border-radius: 5px 5px 3px 3px;
    background: linear-gradient(180deg, rgba(1, 136, 238, .85), rgba(1, 136, 238, .22));
}

.ara-art__chart i:nth-child(1) { height: 34%; }
.ara-art__chart i:nth-child(2) { height: 52%; }
.ara-art__chart i:nth-child(3) { height: 68%; }
.ara-art__chart i:nth-child(4) { height: 58%; }
.ara-art__chart i:nth-child(5) {
    height: 90%;
    background: linear-gradient(180deg, rgba(37, 211, 102, .9), rgba(37, 211, 102, .25));
}

.ara-art__kpi {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .72rem;
    font-weight: 700;
    color: #6EE7A0;
}

.ara-art__kpi i {
    width: 60%;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, .2);
}

/* Desarrollo: código y terminal */
.ara-art__codigo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .5rem;
    flex: 1;
}

.ara-art__codigo span {
    display: flex;
    gap: .35rem;
}

.ara-art__codigo i {
    display: block;
    width: 2.6rem;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, .24);
}

.ara-art__codigo span i:nth-child(1) { width: 1.6rem; background: rgba(94, 176, 255, .8); }
.ara-art__codigo span i:nth-child(2) { width: 3.6rem; background: rgba(255, 255, 255, .5); }
.ara-art__codigo span i:nth-child(3) { width: 2.1rem; background: rgba(37, 211, 102, .7); }
.ara-art__codigo span:nth-child(2n) i:first-child { margin-left: 1.1rem; }

.ara-art__terminal {
    display: flex;
    align-items: center;
    padding: .5rem .6rem;
    border-radius: 8px;
    background: rgba(0, 0, 0, .35);
    border: 1px solid rgba(255, 255, 255, .08);
}

.ara-art__terminal i {
    width: 45%;
    height: 3px;
    border-radius: 2px;
    background: #4EAE33;
}

/* Web: página publicada */
.ara-art__landing {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    flex: 1;
}

.ara-art__l-nav {
    display: flex;
    align-items: center;
    gap: .3rem;
}

.ara-art__l-nav i {
    display: block;
    width: .9rem;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, .3);
}

.ara-art__l-nav i:first-child {
    width: 1.1rem;
    height: .4rem;
    background: rgba(255, 255, 255, .55);
}

.ara-art__l-nav b {
    margin-left: auto;
    width: 1.9rem;
    height: .7rem;
    border-radius: 9999px;
    background: #0188EE;
}

.ara-art__l-hero {
    display: flex;
    flex-direction: column;
    gap: .35rem;
    padding: .3rem 0;
}

.ara-art__l-hero i {
    display: block;
    width: 68%;
    height: .55rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, .8);
}

.ara-art__l-hero i:nth-child(2) {
    width: 45%;
    background: rgba(94, 176, 255, .7);
}

.ara-art__l-hero em {
    display: block;
    width: 3.2rem;
    height: .9rem;
    margin-top: .25rem;
    border-radius: 9999px;
    background: #0188EE;
}

.ara-art__l-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .4rem;
    margin-top: auto;
}

.ara-art__l-cards i {
    display: block;
    height: 2.1rem;
    border-radius: 6px;
    background: rgba(255, 255, 255, .06);
    border: 1px solid rgba(255, 255, 255, .08);
}

.ara-art__paleta {
    display: flex;
    justify-content: center;
    gap: .35rem;
}

.ara-art__paleta i {
    width: .8rem;
    height: .8rem;
    border-radius: 50%;
    background: #0188EE;
}

.ara-art__paleta i:nth-child(2) { background: #4EAE33; }
.ara-art__paleta i:nth-child(3) { background: #7C5CFF; }
.ara-art__paleta i:nth-child(4) { background: #F59E0B; }

/* FAQ: preguntas desplegables */
.ara-art__faq {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .5rem;
    flex: 1;
}

.ara-art__faq > span {
