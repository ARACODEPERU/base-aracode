{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem;margin:0 0 .75rem}.plt-tipo{display:inline-flex;align-items:center;padding:.3rem .7rem;border-radius:9999px;background:var(--plt-navy);color:#fff;font-size:.75rem;font-weight:700;letter-spacing:.02em;white-space:nowrap}.plt-tipo--claro{background:hsla(0,0%,100%,.14);border:1px solid hsla(0,0%,100%,.28)}.plt-card__etiqueta{border-radius:9999px;border:1px solid var(--plt-line);background:var(--plt-mist);color:var(--plt-slate)}.plt-card__destacada,.plt-card__etiqueta{display:inline-flex;align-items:center;padding:.3rem .7rem;font-size:.6875rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}.plt-card__destacada{border-radius:9999px;background:var(--plt-green);color:#fff}.plt-card__cuerpo{display:flex;flex-direction:column;flex:1;padding:1.25rem 1.25rem 1.5rem}.plt-card__nombre{margin:0 0 .5rem;font-size:1.1875rem;line-height:1.3;font-weight:700;color:var(--plt-ink)}.plt-card__nombre a{color:inherit;text-decoration:none}.plt-card__nombre a:hover{color:var(--plt-blue-ink)}.plt-card__resumen{margin:0 0 1rem;font-size:.9375rem;line-height:1.6;color:var(--plt-slate)}.plt-card__etiquetas{display:flex;flex-wrap:wrap;gap:.35rem;margin:0 0 1.25rem;padding:0;list-style:none}.plt-card__etiquetas li{padding:.2rem .55rem;border-radius:9999px;background:var(--plt-mist);color:var(--plt-muted);font-size:.75rem;font-weight:600}.plt-card__acciones{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:auto}.plt-card__acciones .ara-btn{padding:.7rem 1.25rem;font-size:.875rem}.plt-card__acciones .ara-btn svg,.plt-hero .ara-btn svg{width:1rem;height:1rem;flex-shrink:0}.plt-vacio{grid-column:1/-1;padding:3rem 1.5rem;border-radius:var(--plt-radius);border:1px dashed var(--plt-line);background:var(--plt-mist);text-align:center}.plt-vacio__titulo{margin:0 0 .5rem;font-size:1.125rem;font-weight:700;color:var(--plt-ink)}.plt-vacio__texto{margin:0 auto 1.25rem;max-width:34rem;color:var(--plt-slate)}.plt-captura{position:relative;aspect-ratio:16/10;margin-bottom:2.5rem;overflow:hidden;border-radius:var(--plt-radius);border:1px solid var(--plt-line);background:var(--plt-mist);box-shadow:0 22px 50px -34px rgba(6,14,45,.5)}.plt-captura img{display:block;width:100%;height:100%;-o-object-fit:cover;object-fit:cover;-o-object-position:top center;object-position:top center}.plt-breadcrumb{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;margin:0;padding:0;list-style:none;font-size:.875rem;color:hsla(0,0%,100%,.6)}.plt-breadcrumb a{color:hsla(0,0%,100%,.82);text-decoration:none}.plt-breadcrumb a:hover{color:#fff;text-decoration:underline}.plt-ficha{display:grid;grid-template-columns:1fr;gap:2.5rem}@media (min-width:1024px){.plt-ficha{grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:3rem}}.plt-nota{margin:1.25rem 0 0;padding-top:1.25rem;border-top:1px solid var(--plt-line);font-size:.875rem;line-height:1.6;color:var(--plt-slate)}.plt-nota__etiqueta{margin-right:.35rem;color:var(--plt-blue-ink)}.plt-bloque{margin-bottom:2.5rem}.plt-bloque__titulo{margin:0 0 1rem;font-size:1.25rem;font-weight:700;color:var(--plt-ink)}.plt-lista{margin:0;padding:0;list-style:none;display:grid;gap:.75rem}.plt-lista li{display:flex;align-items:flex-start;gap:.6rem;color:var(--plt-slate);line-height:1.55}.plt-lista svg{width:1.15rem;height:1.15rem;margin-top:.15rem;flex-shrink:0;color:var(--plt-green)}.plt-tech{display:flex;flex-wrap:wrap;gap:.5rem;margin:0;padding:0;list-style:none}.plt-tech li{padding:.35rem .8rem;border-radius:9999px;border:1px solid var(--plt-line);background:var(--plt-mist);color:var(--plt-slate);font-size:.8125rem;font-weight:600}.plt-panel{align-self:start;padding:1.5rem;border-radius:var(--plt-radius);border:1px solid var(--plt-line);background:#fff;box-shadow:0 18px 40px -32px rgba(6,14,45,.45)}@media (min-width:1024px){.plt-panel{position:sticky;top:6.5rem}}.plt-panel__acciones{display:grid;gap:.75rem;margin-bottom:1.5rem}.plt-panel__acciones .ara-btn{width:100%}.plt-datos{margin:0;display:grid;gap:.75rem;font-size:.9375rem}.plt-datos div{display:flex;justify-content:space-between;gap:1rem;padding-bottom:.75rem;border-bottom:1px solid var(--plt-line)}.plt-datos div:last-child{padding-bottom:0;border-bottom:0}.plt-datos dt{color:var(--plt-muted)}.plt-datos dd{margin:0;color:var(--plt-ink);font-weight:600;text-align:right}.plt-aviso{display:flex;gap:.6rem;padding:.85rem 1rem;border-radius:.75rem;background:rgba(1,136,238,.08);border:1px solid rgba(1,136,238,.22);color:var(--plt-blue-ink);font-size:.875rem;line-height:1.5}.plt-aviso svg{width:1.1rem;height:1.1rem;margin-top:.15rem;flex-shrink:0}@media (prefers-reduced-motion:reduce){.plt-card,.plt-card__media img{transition:none}.plt-card:hover,.plt-card:hover .plt-card__media img{transform:none}}

/* ---------- Portada del catálogo: maqueta dibujada con CSS ---------- */
/* Dos columnas en escritorio; en tablet la maqueta baja debajo del texto. */
.plt-hero__grid{display:grid;grid-template-columns:minmax(0,1fr);gap:2.5rem;align-items:center}
@media (min-width:1024px){.plt-hero__grid{grid-template-columns:minmax(0,1.02fr) minmax(0,.98fr);gap:3rem}}

.plt-demo{display:none}
@media (min-width:768px){
    /* width:100% + max-width: en rejilla: con márgenes auto el ancho sería 0 */
    .plt-demo{display:block;position:relative;width:100%;max-width:32rem;margin:2.5rem auto 0;
        aspect-ratio:4/3.15;--acc:#0188EE}
}
@media (min-width:1024px){.plt-demo{margin:0;max-width:none;aspect-ratio:4/3.15}}

/* Halo: se tiñe con el color de marca elegido */
.plt-demo__halo{position:absolute;inset:8% -7% 0 -5%;z-index:0;pointer-events:none;filter:blur(38px);opacity:.9;
    background:radial-gradient(58% 58% at 72% 22%,rgba(1,136,238,.5),transparent 70%),
               radial-gradient(46% 46% at 20% 84%,rgba(37,211,102,.3),transparent 70%)}

/* La ventana del editor */
.plt-demo__ventana{position:absolute;inset:3% 0 9% 0;z-index:2;display:flex;flex-direction:column;overflow:hidden;
    border-radius:16px;background:#07122C;border:1px solid rgba(130,180,255,.3);
    box-shadow:0 40px 80px -40px rgba(0,0,0,.95),0 0 0 1px rgba(0,0,0,.25);
    transform:rotate(-1.2deg);animation:plt-demo-flota 8s ease-in-out infinite alternate}
@keyframes plt-demo-flota{from{transform:rotate(-1.2deg) translateY(0)}to{transform:rotate(-1.2deg) translateY(-9px)}}

.plt-demo__barra{display:flex;align-items:center;gap:.32rem;padding:.5rem .75rem;flex:0 0 auto;
    background:rgba(255,255,255,.055);border-bottom:1px solid rgba(255,255,255,.07)}
.plt-demo__barra>i{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.28)}
.plt-demo__barra>i:nth-child(1){background:#FF5F57}
.plt-demo__barra>i:nth-child(2){background:#FEBC2E}
.plt-demo__barra>i:nth-child(3){background:#28C840}
.plt-demo__url{margin-left:.55rem;padding:.15rem .6rem;border-radius:9999px;font-size:.64rem;
    background:rgba(255,255,255,.08);color:rgba(255,255,255,.6)}
.plt-demo__estado{margin-left:auto;font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;
    color:rgba(255,255,255,.4)}

/* El mini-sitio: barra + bloque de texto + tres tarjetas */
.plt-demo__lienzo{position:relative;flex:1 1 auto;min-height:0;display:flex;flex-direction:column;gap:.6rem;
    padding:clamp(.7rem,2.2vw,1rem);background:linear-gradient(170deg,#0A1A3D,#071027 70%)}

.plt-demo__nav{display:flex;align-items:center;gap:.4rem;flex:0 0 auto}
.plt-demo__logo{width:1.15rem;height:.5rem;border-radius:3px;
    background:linear-gradient(90deg,var(--acc),#4EAE33);transition:background .5s ease}
.plt-demo__enlaces{display:flex;gap:.32rem;margin-left:auto}
.plt-demo__enlaces i{display:block;width:.8rem;height:3px;border-radius:2px;background:rgba(255,255,255,.22)}
.plt-demo__nav-cta{width:1.9rem;height:.68rem;border-radius:9999px;margin-left:.35rem;
    background:var(--acc);transition:background .5s ease}

.plt-demo__bloque{position:relative;margin-top:.2rem;padding:.85rem .95rem;border-radius:10px;
    background:radial-gradient(120% 130% at 85% 0,rgba(255,255,255,.07),transparent 62%);
    border:1px solid rgba(255,255,255,.07)}
.plt-demo__etiqueta{display:block;width:2.3rem;height:5px;border-radius:2px;
    background:var(--acc);transition:background .5s ease}
.plt-demo__titular{display:block;width:84%;height:.62rem;border-radius:3px;margin-top:.5rem;background:rgba(255,255,255,.86)}
.plt-demo__titular--corto{width:57%;margin-top:.34rem}
.plt-demo__texto{display:block;width:70%;height:4px;border-radius:2px;margin-top:.55rem;background:rgba(255,255,255,.26)}
.plt-demo__texto--corto{width:46%;margin-top:.3rem}
.plt-demo__boton{display:block;width:3.1rem;height:1rem;border-radius:9999px;margin-top:.75rem;
    background:var(--acc);box-shadow:0 10px 22px -10px var(--acc);transition:background .5s ease,box-shadow .5s ease}

/* Marco de selección del editor sobre el bloque */
.plt-demo__marco{position:absolute;inset:-1.5px;border:1.5px solid var(--acc);border-radius:11px;pointer-events:none;
    box-shadow:0 0 0 1px rgba(4,10,26,.35),0 0 26px -6px var(--acc);transition:border-color .5s ease,box-shadow .5s ease}
.plt-demo__marco::before,.plt-demo__marco::after{content:"";position:absolute;width:7px;height:7px;border-radius:50%;
    background:#fff;box-shadow:0 0 0 1.5px var(--acc)}
.plt-demo__marco::before{left:-4px;top:-4px}
.plt-demo__marco::after{right:-4px;bottom:-4px}
.plt-demo__marco-tag{position:absolute;top:-.6rem;left:.85rem;padding:.1rem .45rem;border-radius:4px;background:var(--acc);
    color:#fff;font-size:.55rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;
    transition:background .5s ease}

.plt-demo__tarjetas{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem;margin-top:auto}
.plt-demo__tarjeta{display:flex;flex-direction:column;gap:.28rem;padding:.5rem;border-radius:8px;
    background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.07)}
.plt-demo__icono{display:block;width:.9rem;height:.9rem;border-radius:5px;margin-bottom:.12rem;
    background:var(--acc);opacity:.85;transition:background .5s ease}
.plt-demo__tarjeta i{display:block;width:100%;height:3px;border-radius:2px;background:rgba(255,255,255,.24)}
.plt-demo__tarjeta i:last-child{width:60%}

.plt-demo__chip{position:absolute;left:.3rem;top:-.75rem;z-index:5;display:inline-flex;align-items:center;gap:.4rem;
    padding:.45rem .8rem;border-radius:9999px;font-size:.74rem;font-weight:600;color:#fff;
    background:rgba(6,14,45,.75);border:1px solid rgba(255,255,255,.18);
    -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);box-shadow:0 14px 30px -18px #000}
.plt-demo__chip svg{width:.95rem;height:.95rem;color:var(--plt-green)}

/* Paleta flotante: el JS la recorre y cambia --acc */
.plt-demo__paleta{position:absolute;left:3%;bottom:-1%;z-index:5;display:flex;align-items:center;gap:.45rem;
    padding:.45rem .7rem;border-radius:9999px;background:rgba(6,16,38,.92);border:1px solid rgba(130,180,255,.28);
    box-shadow:0 22px 44px -22px rgba(0,0,0,.95);
    -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}
.plt-demo__paleta-titulo{font-size:.56rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5)}
.plt-demo__muestra{display:block;width:.85rem;height:.85rem;border-radius:50%;background:var(--c);
    box-shadow:0 0 0 2px transparent;transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s ease}
.plt-demo__muestra.is-activa{transform:scale(1.18);box-shadow:0 0 0 2px #fff}

.plt-demo__cursor{position:absolute;left:58%;top:44%;z-index:6;width:16px;height:16px;color:#fff;pointer-events:none;
    filter:drop-shadow(0 4px 8px rgba(0,0,0,.6));
    transition:left .85s cubic-bezier(.45,.05,.2,1),top .85s cubic-bezier(.45,.05,.2,1),transform .18s ease}
.plt-demo__cursor.is-pulsando{transform:scale(.8)}
.plt-demo__cursor svg{display:block;width:100%;height:100%}

@media (max-width:1023px){
    .plt-demo__paleta{left:50%;transform:translateX(-50%);bottom:-.6rem}
}

/* Segunda sección del mini-sitio: imagen + texto que ocupa el alto libre */
.plt-demo__tira{display:grid;grid-template-columns:1.05fr 1fr;gap:.5rem;flex:1 1 auto;min-height:2.6rem;
    align-items:stretch;margin-top:.15rem}
.plt-demo__foto{position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;
    border-radius:8px;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.07)}
.plt-demo__foto::before{content:"";width:52%;aspect-ratio:1;border-radius:50%;background:var(--acc);opacity:.35;
    filter:blur(7px);transition:background .5s ease}
.plt-demo__tira-texto{display:flex;flex-direction:column;justify-content:center;gap:.42rem}
.plt-demo__tira-texto i{display:block;height:4px;border-radius:2px;background:rgba(255,255,255,.24)}
.plt-demo__tira-texto i:nth-child(1){height:.5rem;width:82%;background:rgba(255,255,255,.7)}
.plt-demo__tira-texto i:nth-child(2){width:94%}
.plt-demo__tira-texto i:nth-child(3){width:64%}

/* El halo también se tiñe con el color elegido */
.plt-demo__halo::after{content:"";position:absolute;inset:22% 14% 8% 18%;border-radius:50%;background:var(--acc);
    opacity:.26;filter:blur(50px);transition:background .6s ease}

@media (min-width:1024px){
    /* Portada compacta: la maqueta se mide en vh y los aires se recortan
       para que el catálogo asome en la primera pantalla. */
    .plt-hero{padding:clamp(5.25rem,9vh,6rem) 0 clamp(1rem,2vh,1.5rem)}
    .plt-hero__grid{gap:2.5rem}
    .plt-hero__titulo{font-size:clamp(1.95rem,2.4vw,2.375rem);margin-bottom:.6rem}
    .plt-hero__lead{font-size:.95rem;line-height:1.55}
    .plt-hero__contenido .ara-badge{margin-bottom:.75rem;padding:.3rem .7rem;font-size:.7rem}
    .plt-buscador{margin-top:.9rem;max-width:36rem}
    .plt-buscador__label{margin-bottom:.3rem;font-size:.72rem}
    .plt-buscador__campo{padding:.3rem}
    .plt-buscador__campo .ara-btn{padding:.5rem 1.1rem}
    .plt-buscador input[type=search]{padding:.45rem .5rem}
    /* La ventana dibujada se adapta al alto disponible en vez de imponer su proporción */
    .plt-demo{aspect-ratio:auto;height:clamp(11.5rem,32vh,19rem);max-width:34rem;margin-left:auto}
    .plt-demo__ventana{inset:2% 0 16% 0}
    .plt-demo__paleta{bottom:0}
    /* En una ventana baja no cabe la sección de imagen + texto: se oculta
       para que el bloque seleccionado y las tarjetas respiren. */
    .plt-demo__tira{display:none}
        /* Un solo renglón de titular y de texto: con poco alto el bloque
           conserva el aire suficiente para que se vean las tarjetas. */
    .plt-demo__bloque{padding:.65rem .8rem}
    .plt-demo__titular{height:.55rem;margin-top:.4rem}
    .plt-demo__titular--corto,
    .plt-demo__texto--corto{display:none}
    .plt-demo__texto{margin-top:.4rem}
    .plt-demo__boton{margin-top:.55rem;height:.85rem;width:2.6rem}
}
