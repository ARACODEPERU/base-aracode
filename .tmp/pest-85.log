    document.addEventListener('DOMContentLoaded', function() {\n
        // Intersection Observer for reveal animations\n
        const observerOptions = {\n
            root: null,\n
            rootMargin: '0px',\n
            threshold: 0.1\n
        };\n
\n
        const observer = new IntersectionObserver(function(entries) {\n
            entries.forEach(function(entry) {\n
                if (entry.isIntersecting) {\n
                    entry.target.classList.add('revealed');\n
                    // Don't unobserve - allow re-animation if needed\n
                }\n
            });\n
        }, observerOptions);\n
\n
        // Observe all reveal elements\n
        document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach(function(el) {\n
            observer.observe(el);\n
        });\n
\n
        // Navbar scroll effect\n
        const nav = document.querySelector('.ara-nav');\n
        if (nav) {\n
            window.addEventListener('scroll', function() {\n
                if (window.scrollY > 50) {\n
                    nav.classList.add('scrolled');\n
                } else {\n
                    nav.classList.remove('scrolled');\n
                }\n
            });\n
        }\n
\n
        // Mobile menu toggle\n
        const menuBtn = document.querySelector('.ara-menu-btn');\n
        const mobileMenu = document.querySelector('.ara-mobile-menu');\n
        const menuClose = document.querySelector('.ara-menu-close');\n
\n
        if (menuBtn && mobileMenu) {\n
            menuBtn.addEventListener('click', function() {\n
                mobileMenu.classList.add('active');\n
                document.body.style.overflow = 'hidden';\n
            });\n
        }\n
\n
        if (menuClose && mobileMenu) {\n
            menuClose.addEventListener('click', function() {\n
                mobileMenu.classList.remove('active');\n
                document.body.style.overflow = '';\n
            });\n
        }\n
\n
        // Close mobile menu on link click\n
        document.querySelectorAll('.ara-mobile-menu .nav-link').forEach(function(link) {\n
            link.addEventListener('click', function() {\n
                mobileMenu.classList.remove('active');\n
                document.body.style.overflow = '';\n
            });\n
        });\n
\n
        // Counter animation\n
        function animateCounter(el) {\n
            const target = parseInt(el.getAttribute('data-target'));\n
            const suffix = el.getAttribute('data-suffix') || '';\n
            const duration = 2000;\n
            const start = 0;\n
            const increment = target / (duration / 16);\n
            \n
            let current = start;\n
            const timer = setInterval(function() {\n
                current += increment;\n
                if (current >= target) {\n
                    current = target;\n
                    clearInterval(timer);\n
                }\n
                el.textContent = Math.floor(current) + suffix;\n
            }, 16);\n
        }\n
\n
        // Observe counters\n
        const counterObserver = new IntersectionObserver(function(entries) {\n
            entries.forEach(function(entry) {\n
                if (entry.isIntersecting) {\n
                    animateCounter(entry.target);\n
                    counterObserver.unobserve(entry.target);\n
                }\n
            });\n
        }, { threshold: 0.5 });\n
\n
        document.querySelectorAll('[data-counter]').forEach(function(el) {\n
            counterObserver.observe(el);\n
        });\n
\n
        // Smooth scroll for anchor links\n
        document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {\n
            anchor.addEventListener('click', function(e) {\n
                e.preventDefault();\n
                const target = document.querySelector(this.getAttribute('href'));\n
                if (target) {\n
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });\n
                }\n
            });\n
        });\n
\n
        // ==========================================\n
        // Dark Mode Toggle\n
        // ==========================================\n
        const html = document.documentElement;\n
        const themeKey = 'aracode-theme';\n
\n
        // Load saved theme or default to light\n
        const savedTheme = localStorage.getItem(themeKey);\n
        if (savedTheme === 'dark') {\n
            html.classList.add('dark');\n
        }\n
\n
        function toggleTheme() {\n
            html.classList.toggle('dark');\n
            const isDark = html.classList.contains('dark');\n
            localStorage.setItem(themeKey, isDark ? 'dark' : 'light');\n
        }\n
\n
        // Attach to all toggle buttons\n
        document.querySelectorAll('#theme-toggle, #theme-toggle-mobile').forEach(function(btn) {\n
            btn.addEventListener('click', toggleTheme);\n
        });\n
    });\n
