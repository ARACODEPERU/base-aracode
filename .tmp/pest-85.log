    (function() {\n
        var canvas = document.getElementById('hero-particles');\n
        if (!canvas) return;\n
        var ctx = canvas.getContext('2d');\n
        var particles = [];\n
        var isMobile = window.innerWidth < 768;\n
        var particleCount = isMobile ? 35 : 65;\n
        var connectionDistance = 150;\n
        var animationId;\n
        var initialized = false;\n
        var startTime = performance.now();\n
\n
        function getColors() {\n
            var dark = document.documentElement.classList.contains('dark');\n
            return {\n
                core: dark ? 'rgba(100, 200, 255, 1)' : 'rgba(1, 136, 238, 0.9)',\n
                glow: dark ? 'rgba(1, 136, 238, 0.45)' : 'rgba(1, 136, 238, 0.3)',\n
                glowBig: dark ? 'rgba(1, 136, 238, 0.1)' : 'rgba(1, 136, 238, 0.06)',\n
                line: dark ? 'rgba(100, 200, 255, 0.35)' : 'rgba(1, 136, 238, 0.2)',\n
                lightning: dark ? 'rgba(150, 220, 255, 0.65)' : 'rgba(1, 136, 238, 0.5)',\n
                special: dark ? 'rgba(78, 200, 100, 0.85)' : 'rgba(78, 174, 51, 0.6)',\n
                specialGlow: dark ? 'rgba(78, 200, 100, 0.25)' : 'rgba(78, 174, 51, 0.15)'\n
            };\n
        }\n
\n
        function resize() {\n
            var hero = canvas.parentElement;\n
            var w = hero ? hero.offsetWidth : window.innerWidth;\n
            var h = hero ? hero.offsetHeight : 720;\n
            canvas.width = w || 1280;\n
            canvas.height = h || 720;\n
            isMobile = window.innerWidth < 768;\n
            particleCount = isMobile ? 35 : 65;\n
        }\n
\n
        function Particle() {\n
            this.x = Math.random() * canvas.width;\n
            this.y = Math.random() * canvas.height;\n
            this.vx = (Math.random() - 0.5) * 0.35;\n
            this.vy = (Math.random() - 0.5) * 0.35;\n
            this.radius = Math.random() * 2.5 + 1.5;\n
            this.baseOpacity = Math.random() * 0.35 + 0.55;\n
            this.pulseSpeed = Math.random() * 0.012 + 0.004;\n
            this.pulsePhase = Math.random() * Math.PI * 2;\n
            this.isSpecial = Math.random() < 0.1;\n
        }\n
\n
        Particle.prototype.update = function() {\n
            this.x += this.vx;\n
            this.y += this.vy;\n
            this.pulsePhase += this.pulseSpeed;\n
            this.currentOpacity = this.baseOpacity + Math.sin(this.pulsePhase) * 0.2;\n
            if (this.x < -10) this.x = canvas.width + 10;\n
            if (this.x > canvas.width + 10) this.x = -10;\n
            if (this.y < -10) this.y = canvas.height + 10;\n
            if (this.y > canvas.height + 10) this.y = -10;\n
        };\n
\n
        Particle.prototype.draw = function(colors) {\n
            var r = this.radius;\n
            var op = Math.max(0.15, this.currentOpacity);\n
            var col = this.isSpecial ? colors.special : colors.core;\n
            var glowCol = this.isSpecial ? colors.specialGlow : colors.glow;\n
            var glowBigCol = this.isSpecial ? colors.specialGlow : colors.glowBig;\n
\n
            // Outer glow (large, soft bloom)\n
            ctx.beginPath();\n
            ctx.arc(this.x, this.y, r * 5, 0, Math.PI * 2);\n
            ctx.fillStyle = glowBigCol;\n
            ctx.globalAlpha = op * 0.45;\n
            ctx.fill();\n
\n
            // Inner glow (medium bloom)\n
            ctx.beginPath();\n
            ctx.arc(this.x, this.y, r * 2.5, 0, Math.PI * 2);\n
            ctx.fillStyle = glowCol;\n
            ctx.globalAlpha = op * 0.6;\n
            ctx.fill();\n
\n
            // Core (bright dot)\n
            ctx.beginPath();\n
            ctx.arc(this.x, this.y, r, 0, Math.PI * 2);\n
            ctx.fillStyle = col;\n
            ctx.globalAlpha = op;\n
            ctx.fill();\n
\n
            // White hot center\n
            ctx.beginPath();\n
            ctx.arc(this.x, this.y, r * 0.4, 0, Math.PI * 2);\n
            ctx.fillStyle = '#fff';\n
            ctx.globalAlpha = op * 0.75;\n
            ctx.fill();\n
\n
            ctx.globalAlpha = 1;\n
        };\n
\n
        function drawLightning(x1, y1, x2, y2, colors, alpha) {\n
            var segments = 5;\n
            var dx = (x2 - x1) / segments;\n
            var dy = (y2 - y1) / segments;\n
            var points = [{x: x1, y: y1}];\n
            var jitter = 18;\n
            for (var s = 1; s < segments; s++) {\n
                var midX = x1 + dx * s + (Math.random() - 0.5) * jitter;\n
                var midY = y1 + dy * s + (Math.random() - 0.5) * jitter;\n
                points.push({x: midX, y: midY});\n
            }\n
            points.push({x: x2, y: y2});\n
\n
            // Glow layer (wide, soft)\n
            ctx.beginPath();\n
            ctx.moveTo(points[0].x, points[0].y);\n
            for (var p = 1; p < points.length; p++) {\n
                ctx.lineTo(points[p].x, points[p].y);\n
            }\n
            ctx.strokeStyle = colors.glow;\n
            ctx.globalAlpha = alpha * 0.22;\n
            ctx.lineWidth = 3.5;\n
            ctx.stroke();\n
\n
            // Main bolt\n
            ctx.beginPath();\n
            ctx.moveTo(points[0].x, points[0].y);\n
            for (var p = 1; p < points.length; p++) {\n
                ctx.lineTo(points[p].x, points[p].y);\n
            }\n
            ctx.strokeStyle = colors.lightning;\n
            ctx.globalAlpha = alpha * 0.55;\n
            ctx.lineWidth = 1;\n
            ctx.stroke();\n
\n
            // Bright core\n
            ctx.beginPath();\n
            ctx.moveTo(points[0].x, points[0].y);\n
            for (var p = 1; p < points.length; p++) {\n
                ctx.lineTo(points[p].x, points[p].y);\n
            }\n
            ctx.strokeStyle = '#fff';\n
            ctx.globalAlpha = alpha * 0.3;\n
            ctx.lineWidth = 0.4;\n
            ctx.stroke();\n
\n
            ctx.globalAlpha = 1;\n
        }\n
\n
        function drawConnections(colors) {\n
            for (var i = 0; i < particles.length; i++) {\n
                for (var j = i + 1; j < particles.length; j++) {\n
                    var dx = particles[i].x - particles[j].x;\n
                    var dy = particles[i].y - particles[j].y;\n
                    var dist = Math.sqrt(dx * dx + dy * dy);\n
                    if (dist < connectionDistance) {\n
                        var alpha = 1 - (dist / connectionDistance);\n
                        if (alpha > 0.35) {\n
                            drawLightning(particles[i].x, particles[i].y, particles[j].x, particles[j].y, colors, alpha);\n
                        } else {\n
                            ctx.beginPath();\n
                            ctx.moveTo(particles[i].x, particles[i].y);\n
                            ctx.lineTo(particles[j].x, particles[j].y);\n
                            ctx.strokeStyle = colors.line;\n
                            ctx.globalAlpha = alpha * 0.45;\n
                            ctx.lineWidth = 0.5;\n
                            ctx.stroke();\n
                            ctx.globalAlpha = 1;\n
                        }\n
                    }\n
                }\n
            }\n
        }\n
\n
        function init() {\n
            resize();\n
            particles = [];\n
            for (var i = 0; i < particleCount; i++) particles.push(new Particle());\n
        }\n
\n
        function animate() {\n
            ctx.clearRect(0, 0, canvas.width, canvas.height);\n
            var colors = getColors();\n
            for (var i = 0; i < particles.length; i++) {\n
                particles[i].update();\n
                particles[i].draw(colors);\n
            }\n
            drawConnections(colors);\n
            animationId = requestAnimationFrame(animate);\n
        }\n
\n
        function startParticles() {\n
            if (!initialized) {\n
                init();\n
                animate();\n
                initialized = true;\n
            }\n
        }\n
\n
        window.addEventListener("resize", function() {\n
            resize();\n
            while (particles.length < particleCount) particles.push(new Particle());\n
            while (particles.length > particleCount) particles.pop();\n
            if (!initialized) startParticles();\n
        });\n
\n
        // Intento inicial: esperar hasta que el canvas tenga dimensiones reales (máx 1.5s)\n
        function tryStart() {\n
            var ww = canvas.parentElement ? canvas.parentElement.offsetWidth : 0;\n
            if (ww > 0 && canvas.width > 0) {\n
                startParticles();\n
            } else if (performance.now() - startTime < 1500) {\n
                requestAnimationFrame(tryStart);\n
            } else {\n
                // Fallback: forzar resize e iniciar\n
                resize();\n
                startParticles();\n
            }\n
        }\n
        requestAnimationFrame(tryStart);\n
    })();\n
