document.addEventListener('DOMContentLoaded', function () {\n
    var modal = document.getElementById('asesoriaModal');\n
    var formulario = document.getElementById('asesoriaForm');\n
\n
    if (!modal || !formulario) {\n
        return;\n
    }\n
\n
    var ventana = modal.querySelector('.ara-modal-ventana');\n
    var alerta = document.getElementById('asesoriaError');\n
    var exito = document.getElementById('asesoriaExito');\n
    var exitoTexto = document.getElementById('asesoriaExitoTexto');\n
    var botones = document.querySelectorAll('[data-asesoria]');\n
    var botonDeOrigen = null;\n
    var captchaV3 = formulario.querySelector('#asesoriaRecaptcha');\n
    var captchaV2 = document.getElementById('asesoriaCaptcha');\n
    var versionCaptcha = modal.dataset.captchaVersion || '';\n
    var sitekeyCaptcha = modal.dataset.captchaSitekey || '';\n
    var widgetCaptcha = null;\n
    var apiCaptcha = null;\n
\n
    // ---------------------------------------------------------------- captcha\n
    // Se carga el script de Google solo si la página no lo trae ya (en\n
    // /contacto lo trae su propio formulario) y solo si hay claves.\n
    function cargarApiCaptcha() {\n
        if (window.grecaptcha) {\n
            return Promise.resolve();\n
        }\n
\n
        if (apiCaptcha) {\n
            return apiCaptcha;\n
        }\n
\n
        apiCaptcha = new Promise(function (resolver) {\n
            var existente = document.querySelector('script[src*="recaptcha/api.js"]');\n
\n
            if (existente) {\n
                existente.addEventListener('load', resolver);\n
                existente.addEventListener('error', resolver);\n
                return;\n
            }\n
\n
            // v3 necesita la clave EN LA URL: sin ella, `grecaptcha.execute`\n
            // responde «Invalid site key or not loaded in api.js». v2, en\n
            // cambio, se dibuja a mano y pide el modo explícito.\n
            var script = document.createElement('script');\n
            script.src = versionCaptcha === 'v2'\n
                ? 'https://www.google.com/recaptcha/api.js?render=explicit'\n
                : 'https://www.google.com/recaptcha/api.js?render=' + encodeURIComponent(sitekeyCaptcha);\n
            script.async = true;\n
            script.defer = true;\n
            script.onload = resolver;\n
            script.onerror = resolver;\n
            document.head.appendChild(script);\n
        });\n
\n
        return apiCaptcha;\n
    }\n
\n
    // v3: el token es invisible y se pide justo antes de enviar, porque cada\n
    // token sirve una sola vez. Si Google no responde a tiempo, lanza o devuelve\n
    // un token vacío, se envía igual y el servidor contesta con su mensaje de\n
    // captcha: el botón nunca se queda en «Enviando...» para siempre.\n
    function tokenCaptcha() {\n
        if (!captchaV3) {\n
            return Promise.resolve('');\n
        }\n
\n
        return cargarApiCaptcha().then(function () {\n
            return new Promise(function (resolver) {\n
                var resuelto = false;\n
\n
                function terminar(token) {\n
                    if (resuelto) {\n
                        return;\n
                    }\n
\n
                    resuelto = true;\n
                    resolver(token || '');\n
                }\n
\n
                setTimeout(function () { terminar(''); }, 8000);\n
\n
                if (!window.grecaptcha) {\n
                    return terminar('');\n
                }\n
\n
                try {\n
                    window.grecaptcha.ready(function () {\n
                        var ejecucion;\n
\n
                        try {\n
                            ejecucion = window.grecaptcha.execute(sitekeyCaptcha, { action: 'contacto_submit' });\n
                        } catch (error) {\n
                            return terminar('');\n
                        }\n
\n
                        ejecucion.then(terminar).catch(function () { terminar(''); });\n
                    });\n
                } catch (error) {\n
                    terminar('');\n
                }\n
            });\n
        });\n
    }\n
\n
    // v2: la casilla se dibuja al abrir el modal (oculto no se puede dibujar).\n
    function prepararCaptchaV2() {\n
        if (!captchaV2 || widgetCaptcha !== null) {\n
            return;\n
        }\n
\n
        cargarApiCaptcha().then(function () {\n
            if (!window.grecaptcha || widgetCaptcha !== null) {\n
                return;\n
            }\n
\n
            try {\n
                widgetCaptcha = window.grecaptcha.render(captchaV2, { sitekey: captchaV2.dataset.sitekey });\n
            } catch (error) {\n
                widgetCaptcha = 0;\n
            }\n
        });\n
    }\n
\n
    // Un token ya usado no vale dos veces: la casilla se reinicia después de\n
    // cada intento para que el siguiente envío no viaje con uno gastado.\n
    function reiniciarCaptcha() {\n
        if (widgetCaptcha !== null && window.grecaptcha && typeof window.grecaptcha.reset === 'function') {\n
            try { window.grecaptcha.reset(widgetCaptcha); } catch (error) { /* el widget ya no está */ }\n
        }\n
    }\n
\n
    // ------------------------------------------------------------ abrir cerrar\n
    function ocultarError() {\n
        alerta.hidden = true;\n
        alerta.innerHTML = '';\n
    }\n
\n
    function abrirModal(disparador) {\n
        botonDeOrigen = disparador || null;\n
\n
        // El menú móvil tapa el modal cuando está abierto: se cierra antes.\n
        var menu = document.querySelector('.ara-mobile-menu');\n
        if (menu) {\n
            menu.classList.remove('active');\n
        }\n
\n
        ocultarError();\n
        modal.hidden = false;\n
        document.body.style.overflow = 'hidden';\n
\n
        // El foco entra en el modal: es un diálogo, no un bloque más del fondo.\n
        // Se busca dentro de los campos a la vista: el campo trampa es invisible,\n
        // así que enfocarlo dejaría el foco perdido fuera de la pantalla.\n
        var primero = formulario.querySelector('.ara-modal-campos input:not([type="hidden"]), .ara-modal-campos select, .ara-modal-campos textarea');\n
        if (primero) {\n
            primero.focus();\n
        }\n
\n
        prepararCaptchaV2();\n
    }\n
\n
    function cerrarModal() {\n
        modal.hidden = true;\n
        document.body.style.overflow = '';\n
\n
        // Si se envió bien, al volver a abrir se muestra otra vez el formulario.\n
        if (!exito.hidden) {\n
            exito.hidden = true;\n
            formulario.hidden = false;\n
        }\n
\n
        ocultarError();\n
        reiniciarCaptcha();\n
\n
        if (botonDeOrigen) {\n
            botonDeOrigen.focus();\n
        }\n
    }\n
\n
    // Cada botón «Solicitar Asesoría» del sitio abre el modal. El `href` sigue\n
    // puesto: sin JavaScript el clic lleva a /contacto como siempre.\n
    botones.forEach(function (boton) {\n
        boton.addEventListener('click', function (evento) {\n
            evento.preventDefault();\n
            abrirModal(boton);\n
        });\n
    });\n
\n
    modal.querySelectorAll('[data-asesoria-cerrar]').forEach(function (cerrar) {\n
        cerrar.addEventListener('click', cerrarModal);\n
    });\n
\n
    // Escape cierra y el tabulador se queda dentro del diálogo.\n
    modal.addEventListener('keydown', function (evento) {\n
        if (evento.key === 'Escape') {\n
            cerrarModal();\n
            return;\n
        }\n
\n
        if (evento.key !== 'Tab') {\n
            return;\n
        }\n
\n
        // `tabIndex >= 0` deja fuera lo que no se puede alcanzar con el teclado:\n
        // sin ese filtro, el ciclo pasaría por el campo trampa.\n
        var enfocables = Array.prototype.filter.call(\n
            ventana.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled])'),\n
            function (elemento) { return elemento.offsetParent !== null && elemento.tabIndex >= 0; }\n
        );\n
\n
        if (enfocables.length === 0) {\n
            return;\n
        }\n
\n
        var primero = enfocables[0];\n
        var ultimo = enfocables[enfocables.length - 1];\n
\n
        if (evento.shiftKey && document.activeElement === primero) {\n
            evento.preventDefault();\n
            ultimo.focus();\n
        } else if (!evento.shiftKey && document.activeElement === ultimo) {\n
            evento.preventDefault();\n
            primero.focus();\n
        }\n
    });\n
\n
    // -------------------------------------------------------------- enviar\n
    function mostrarError(mensajes) {\n
        var titulo = document.createElement('strong');\n
        titulo.textContent = mensajes.length > 1 ? 'Revisa estos datos:' : 'No pudimos enviar la solicitud:';\n
\n
        alerta.innerHTML = '';\n
        alerta.appendChild(titulo);\n
\n
        mensajes.forEach(function (mensaje) {\n
            var linea = document.createElement('p');\n
            linea.textContent = mensaje;\n
            alerta.appendChild(linea);\n
        });\n
\n
        alerta.hidden = false;\n
        alerta.scrollIntoView({ block: 'nearest' });\n
    }\n
\n
    function mensajesDeError(errores) {\n
        var mensajes = [];\n
\n
        Object.keys(errores || {}).forEach(function (campo) {\n
            (errores[campo] || []).forEach(function (mensaje) {\n
                mensajes.push(mensaje);\n
            });\n
        });\n
\n
        return mensajes.length > 0 ? mensajes : ['Revisa los datos del formulario e intenta nuevamente.'];\n
    }\n
\n
    formulario.addEventListener('submit', function (evento) {\n
        evento.preventDefault();\n
        ocultarError();\n
\n
        var boton = formulario.querySelector('button[type="submit"]');\n
        var textoOriginal = boton.innerHTML;\n
        boton.disabled = true;\n
        boton.innerHTML = ' Enviando...';\n
\n
        tokenCaptcha().then(function (token) {\n
            if (captchaV3 && token) {\n
                captchaV3.value = token;\n
            }\n
\n
            return fetch(formulario.action, {\n
                method: 'POST',\n
                headers: {\n
                    'X-CSRF-TOKEN': formulario.querySelector('input[name="_token"]').value,\n
                    'X-Requested-With': 'XMLHttpRequest',\n
                    'Accept': 'application/json'\n
                },\n
                body: new FormData(formulario)\n
            }).then(function (respuesta) {\n
                return respuesta.json()\n
                    .then(function (datos) { return { estado: respuesta.status, datos: datos }; })\n
                    .catch(function () { return { estado: respuesta.status, datos: {} }; });\n
            });\n
        }).then(function (resultado) {\n
            boton.disabled = false;\n
            boton.innerHTML = textoOriginal;\n
\n
            if (resultado.estado === 200 && resultado.datos.success) {\n
                exitoTexto.textContent = resultado.datos.message || 'Nos pondremos en contacto contigo pronto.';\n
                formulario.reset();\n
                formulario.hidden = true;\n
                exito.hidden = false;\n
                exito.querySelector('button').focus();\n
                reiniciarCaptcha();\n
\n
                return;\n
            }\n
\n
            if (resultado.estado === 422) {\n
                mostrarError(mensajesDeError(resultado.datos.errors));\n
                reiniciarCaptcha();\n
\n
                return;\n
            }\n
\n
            mostrarError([resultado.datos.message || 'No se pudo enviar la solicitud. Intenta nuevamente.']);\n
            reiniciarCaptcha();\n
        }).catch(function () {\n
            boton.disabled = false;\n
            boton.innerHTML = textoOriginal;\n
            mostrarError(['No se pudo enviar la solicitud. Revisa tu conexión e intenta nuevamente.']);\n
            reiniciarCaptcha();\n
        });\n
    });\n
});\n
