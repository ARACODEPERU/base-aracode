# Plantilla de configuración. Copiala a .env y ejecuta `php artisan key:generate`.
# Este archivo DEBE ser un .env válido: una línea que no sea una asignación o un
# comentario con # (por ejemplo un encabezado entre corchetes) hace que Laravel
# ignore el .env completo en silencio y falle por APP_KEY ausente.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# En Laragon con dominio .test, use la URL de su virtual host y el dev server en 127.0.0.1 (evita [::1] y errores CORS en Firefox)
# APP_URL=http://base-aracode.test
# Debe coincidir con APP_URL: si APP_URL es https://… use https://tu-dominio.test:5173
VITE_DEV_SERVER_URL=https://base-aracode.test:5173
VITE_APP_CODE="DOMAINARACODE"

# --- Usuario administrador que crea el seeder (database/seeders/UserRole.php) ---
# Cámbialos antes de instalar en un servidor: si los dejas, el admin queda con
# credenciales conocidas. Reejecutar el seeder nunca sobrescribe la contraseña ya guardada.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=12345678

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MERCADOPAGO_KEY=TEST-1ad9dc20-cc77-4be6-8e3d-085dc5881a79
MERCADOPAGO_TOKEN=TEST-7310437214436886-103010-b28ce9b11b0b7e1f7d94fecfc65d0662-1528538523

URL_CAMPUS=http://campusvirtual.test
URL_AVATAR_CAMPUS=${URL_CAMPUS}/img/users/
URL_IMAGE_COURSES=${URL_CAMPUS}/img/courses/

RECORDS_PAGE_TABLE=20

RECAPTCHA_SITE_KEY=6LenIwIpAAAAAN3rvkZL8vA3ZaVDwVxzLJJZUyPz
RECAPTCHA_SECRET_KEY=6LenIwIpAAAAAA7RdSeb1kZBTEyOpvzyDc67nTIe
# Tipo de captcha en /contacto: v2 (casilla "No soy un robot") o v3 (invisible).
# Debe coincidir con el tipo del par de claves de arriba: si no coincide, el
# widget no entrega el token y el formulario de contacto rechaza los envios.
# Sin RECAPTCHA_SITE_KEY / RECAPTCHA_SECRET_KEY el captcha no se usa.
RECAPTCHA_VERSION=v2

TINY_API_KEY=xmpsrss1dh49by6nnf83jicfv477cz0o31h0xu3ejsnnhsnz

DISC_SPACE=10

VITE_SOCKET_IO_SERVER="http://localhost:3000"
SOCKET_IO_INTERNAL_URL="http://127.0.0.1:3000"
INTERNAL_API_KEY=
ALLOWED_ORIGINS="${APP_URL}"
NODE_BINARY_PATH=
RUTA_CHROMIUM=

# --- Modo Super Editor (módulo Security) ---
# enabled: muestra el interruptor para entrar al modo editor.
# role: rol que puede activarlo. ttl_minutes: minutos antes de que la sesión de edición caduque.
SUPER_EDITOR_ENABLED=true
SUPER_EDITOR_ROLE=admin
SUPER_EDITOR_TTL_MINUTES=30

# --- Asistentes de IA (opcionales: sin clave, las funciones de IA quedan apagadas) ---
# Usadas por el chat/asistente académico y por el módulo de eventos.
API_KEY_IA=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=60
GEMINI_API_KEY=

# Correo al que se avisa de incidencias del sistema (config/services.php).
MAIL_ADMIN=

# --- Importación desde Facturador3 (módulo Ventas) ---
# Base de datos de origen del import. Sin estos datos, la importación no se usa.
FACTURADOR3_DB_HOST=${DB_HOST}
FACTURADOR3_DB_PORT=${DB_PORT}
FACTURADOR3_DB_DATABASE=
FACTURADOR3_DB_USERNAME=
FACTURADOR3_DB_PASSWORD=
FACTURADOR3_IMPORT_CHUNK_SIZE=1000
FACTURADOR3_IMPORT_QUEUE=imports

# --- Ajustes de módulos con valor por defecto (se pueden omitir) ---
TREASURY_AUTO_INCOME=true
TREASURY_BACKFILL_SINCE=2020-01-01
BIB_READING_CACHE_TTL=43200
BIB_READING_PERSIST_DELTA=5
SOCIALEVENTS_LANDING_CACHE=true
SOCIALEVENTS_LANDING_CACHE_TTL=120
MERCADOPAGO_MAX_INSTALLMENTS=12
# En local, evita que Greenter escriba XML/PDF en disco al probar comprobantes.
GREENTER_NO_FILES=
